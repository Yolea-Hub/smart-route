{
  "name": "smart-route",
  "version": "0.2.0",
  "private": true,
  "description": "Smart Route - desktop smart router for Claude, Gemini and ChatGPT",
  "main": "./out/main/index.js",
  "author": {
    "name": "Yolea",
    "email": "contact@yolea.ai"
  },
  "license": "Apache-2.0",
  "homepage": "https://smartroute.yolea.ai",
  "desktopName": "smart-route.desktop",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && vite build --config vite.web.config.ts",
    "a11y": "node scripts/a11y-audit.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "icons": "node scripts/render-icons.mjs",
    "export:recipes": "node scripts/export-recipes.mjs",
    "export:licences": "node scripts/export-licences.mjs",
    "dist": "pnpm build && electron-builder --linux AppImage",
    "dist:linux": "pnpm build && electron-builder --linux AppImage deb --x64 --publish never",
    "dist:win": "pnpm build && electron-builder --win nsis --x64 --publish never",
    "dist:mac": "pnpm build && electron-builder --mac dmg --arm64 --x64 --publish never"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.2.1",
    "axe-core": "4.14.0",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ws": "8.22.1",
    "zod": "4.6.7"
  }
}
